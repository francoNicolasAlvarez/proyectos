# Base de datos (rol de la aplicación, sin BYPASSRLS)
DATABASE_URL=postgres://app_runtime:change_me@localhost:5432/pedidos
# Rol de migraciones (solo para migrar)
MIGRATION_DATABASE_URL=postgres://app_migrator:change_me@localhost:5432/pedidos

REDIS_URL=redis://localhost:6379

# Sesiones y cifrado (generar valores aleatorios largos; nunca commitear los reales)
# PICKUP_SECRET y MP_WEBHOOK_SECRET: mínimo 32 caracteres aleatorios.
PICKUP_SECRET=change_me_to_a_long_random_value_32_chars_min
# TOKEN_ENCRYPTION_KEY: 32 bytes en base64 (openssl rand -base64 32). Cifra los tokens de Mercado Pago de cada local.
TOKEN_ENCRYPTION_KEY=change_me
ALLOWED_ORIGINS=http://localhost:5173

# Mercado Pago (credenciales de prueba en desarrollo)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=change_me_to_a_long_random_value_32_chars_min

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
